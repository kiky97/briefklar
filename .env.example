# Copy to .env and fill in. Never commit .env.

# Apertus, via any OpenAI-compatible endpoint (Public AI gateway, local vLLM, ...)
APERTUS_BASE_URL=https://hackapertus.livemap.sh/v1
APERTUS_API_KEY=
# Check the exact id with: python scripts/list_models.py
APERTUS_MODEL=apertus-v1.5-70b
APERTUS_TEMPERATURE=0.2
APERTUS_MAX_TOKENS=1500

# Set to 1 to run the UI and tests without any model (regex stand-in)
MOCK_LLM=0

# Optional: a DIFFERENT open-weights model used only as an evaluation judge
# JUDGE_BASE_URL=https://api.publicai.co/v1
# JUDGE_API_KEY=
# JUDGE_MODEL=
