# Copy to .env (next to the Makefile) and fill in. Never commit .env.
# Names follow the Hack Apertus template.

LLM_NAME=apertus-v1.5-70b
LLM_BASE_URL=https://hackapertus.livemap.sh/v1
LLM_API_KEY=

# Optional tuning
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500

# Set to 1 to click through the UI without any model (regex stand-in, for development only)
MOCK_LLM=0
